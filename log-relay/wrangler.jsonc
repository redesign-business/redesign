{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redesign-log-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "LOG_RUNS",
        "class_name": "LogRun"
